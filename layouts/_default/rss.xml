{{- /* Feeds: the home page and the blog list the articles (newest first); other sections list their own pages. */ -}}
{{- $pages := .RegularPages -}}
{{- if .IsHome }}{{ $pages = where site.RegularPages "Section" "blog" }}{{ end -}}
{{- $pages = $pages.ByDate.Reverse -}}
{{- $limit := site.Config.Services.RSS.Limit -}}
{{- if ge $limit 1 }}{{ $pages = $pages | first $limit }}{{ end -}}
{{- $blog := site.GetPage "blog" -}}
{{- $title := cond .IsHome (printf "%s — %s" site.Title $blog.Title) (printf "%s — %s" .Title site.Title) -}}
{{- $desc := .Description | default site.Params.description -}}
{{- if .IsHome }}{{ $desc = $blog.Description | default site.Params.description }}{{ end -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ $title }}</title>
    <link>{{ cond .IsHome $blog.Permalink .Permalink }}</link>
    <description>{{ $desc }}</description>
    <language>{{ site.Language.LanguageCode | default site.Language.Lang }}</language>
    {{- with $pages }}{{ with index . 0 }}{{ if not .Date.IsZero }}
    <lastBuildDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>{{ end }}{{ end }}{{ end }}
    {{- with .OutputFormats.Get "RSS" }}
    {{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType | safeHTML }}{{ end }}
    {{- range $pages }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      {{- if not .Date.IsZero }}
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>{{ end }}
      <guid>{{ .Permalink }}</guid>
      <description>{{ .Description | default (.Params.summary | default .Summary) | plainify }}</description>
    </item>
    {{- end }}
  </channel>
</rss>
